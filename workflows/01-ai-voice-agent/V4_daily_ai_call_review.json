      "id": "4f9106d2-f3e0-435c-8bef-590d057e437b",
      "name": "Happ API · дзвінки за добу",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        112
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.happ.tools/api/calls-history",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "companyId",
              "value": "2f7f8c9c-4710-4830-89c2-f0614916e9e6"
            },
            {
              "name": "filter",
              "value": "=assistantId:eq:YOUR_HAPP_ASSISTANT_ID;status:eq:transcribed;callDate:gte:{{ $now.setZone('Europe/Kyiv').minus({ days: 1 }).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "take",
              "value": "100"
            },
            {
              "name": "sortBy",
              "value": "callDate"
            },
            {
              "name": "sortOrder",
              "value": "ASC"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "64823b9e-d03f-4e7e-8530-282a50af3abb",
