      "typeVersion": 4.3,
      "position": [
        1120,
        32
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.dynamicVariables?.lead_id ? 'https://www.zohoapis.eu/crm/v2/Leads/' + $json.dynamicVariables.lead_id : 'https://www.zohoapis.eu/crm/v2/Leads/search?criteria=(Skype_ID:equals:' + ($json.dynamicVariables?.system__conversation_id || 'none') + ')' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "zohoOAuth2Api",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "12444aa4-6093-46a5-8ab9-5018138f1110",
      "name": "Дзвінок для аналізу",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1344,
        32
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "call_id",
              "type": "string",
              "value": "={{ $('Happ API · транскрипт дзвінка').item.json.id }}"
            },
            {
              "id": "a2",
              "name": "call_date",
              "type": "string",
              "value": "={{ $('Happ API · транскрипт дзвінка').item.json.callDate ? DateTime.fromISO($('Happ API · транскрипт дзвінка').item.json.callDate).setZone('Europe/Kyiv').toFormat('yyyy-MM-dd HH:mm') : '' }}"
            },
            {
              "id": "a3",
              "name": "duration",
              "type": "number",
              "value": "={{ $('Happ API · транскрипт дзвінка').item.json.duration || 0 }}"
            },
            {
              "id": "a4",
              "name": "phone",
              "type": "string",
              "value": "={{ $('Happ API · транскрипт дзвінка').item.json.clientPhone || $('Happ API · транскрипт дзвінка').item.json.dynamicVariables?.phone_number || '' }}"
            },
            {
              "id": "a5",
              "name": "lead_id",
              "type": "string",
              "value": "={{ ($json.data || [])[0]?.id || $('Happ API · транскрипт дзвінка').item.json.dynamicVariables?.lead_id || '' }}"
            },
            {
              "id": "a6",
              "name": "score",
              "type": "string",
              "value": "={{ ($json.data || [])[0]?.score_AI ?? '' }}"
            },
            {
              "id": "a7",
              "name": "status",
              "type": "string",
              "value": "={{ ($json.data || [])[0]?.Lead_Status ?? '' }}"
            },
            {
              "id": "a8",
              "name": "score_comment",
              "type": "string",
              "value": "={{ ($json.data || [])[0]?.SCORE_COMMENT ?? '' }}"
            },
            {
              "id": "a9",
              "name": "transcript",
              "type": "string",
              "value": "={{ $('Happ API · транскрипт дзвінка').item.json.transcriptText || ($('Happ API · транскрипт дзвінка').item.json.replies || []).map(r => (r.speaker || r.role) + ': ' + (r.text || r.message)).join('\\n') }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "08754e76-fee1-4d24-b71b-25bf85251d36",
      "name": "AI-аналітик голосових розмов",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1568,
        112
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Дзвінок {{ $json.call_id }} від {{ $json.call_date }}, тривалість {{ $json.duration }} с, телефон {{ $json.phone }}.\nЛід у CRM: {{ $json.lead_id || \"не привʼязаний\" }}, score {{ $json.score }}, статус {{ $json.status }}.\nРозрахунок score: {{ $json.score_comment }}\n\nТранскрипт:\n{{ $json.transcript }}",
        "options": {
          "systemMessage": "Ти — QA-аналітик голосових продажів GrowthLab. Аналізуєш транскрипти вихідних кваліфікаційних дзвінків голосового AI-агента GrowthLab (BANT: потреба й обсяг заявок, терміни, хто ухвалює рішення, бюджет; пакети Старт від $1 500, Ріст від $3 500, Enterprise від $7 000).\n\nЕталон голосового агента: перевіряє, чи зручно говорити; одне коротке питання за раз; віддзеркалює відповідь; не читає списків і довгих монологів; числа вимовляє словами; не перебиває; відпрацьовує заперечення; наприкінці підсумовує і домовляється про дзвінок менеджера; не називає балів; чесно каже, що він AI, якщо спитали.\n\nВизнач: 1) помилки агента з короткими цитатами (довгі репліки, кілька питань разом, пропущені BANT-пункти, перебивання, невідпрацьовані заперечення, не домовився про наступний крок, розбіжність score у CRM з розмовою); 2) проблему клієнта; 3) заперечення і якість відпрацювання; 4) успішний патерн; 5) конкретну правку до промпту голосового агента; 6) оцінку розмови 1–10. Спирайся лише на транскрипт, нічого не вигадуй; якщо транскрипт порожній — помилки «транскрипт порожній», оцінка 0. Пиши українською, кожне поле до 300 символів. Обовʼязково виклич save_call_analysis рівно один раз, потім відповідай словом «збережено»."
        }
      },
      "onError": "continueRegularOutput"
    },
