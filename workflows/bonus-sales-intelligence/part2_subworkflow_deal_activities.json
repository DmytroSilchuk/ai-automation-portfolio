    {
      "id": "16d94d95-ddb0-4f93-bed5-6c68de94c861",
      "name": "Зібрати активності",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Збираємо Notes, Calls, Tasks однієї угоди в компактний JSON для AI-агента\nconst dealId = $('Виклик з основного workflow').first().json.deal_id;\n// Zoho повертає 204 без тіла, якщо записів немає — тоді масив порожній\nconst rows = (name) => {\n  const data = $(name).first().json.data;\n  return Array.isArray(data) ? data : [];\n};\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst daysAgo = (iso) => Math.floor((today - new Date(iso)) / 86400000);\n\nconst notes = rows('Zoho: Notes').map(n => ({\n  title: n.Note_Title,\n  content: n.Note_Content,\n  created: (n.Created_Time || '').slice(0, 10),\n}));\n\nconst calls = rows('Zoho: Calls')\n  .map(c => ({\n    subject: c.Subject,\n    date: (c.Call_Start_Time || '').slice(0, 10),\n    duration: c.Call_Duration,\n    result: c.Description,\n  }))\n  .sort((a, b) => b.date.localeCompare(a.date));\n\nconst tasks = rows('Zoho: Tasks').map(t => {\n  const done = t.Status === 'Completed';\n  return {\n    subject: t.Subject,\n    due_date: t.Due_Date,\n    status: t.Status,\n    priority: t.Priority,\n    overdue: !done && !!t.Due_Date && daysAgo(t.Due_Date) > 0,\n  };\n});\n\nconst lastCall = calls[0]?.date || null;\n\nreturn [{\n  json: {\n    deal_id: dealId,\n    notes,\n    calls,\n    tasks,\n    stats: {\n      notes_count: notes.length,\n      calls_count: calls.length,\n      last_call_date: lastCall,\n      days_since_last_call: lastCall ? daysAgo(lastCall) : null,\n      open_tasks: tasks.filter(t => t.status !== 'Completed').length,\n      overdue_tasks: tasks.filter(t => t.overdue).length,\n    },\n  },\n}];\n"
      }
    }
  ],
