    {
      "id": "707e7042-5fd0-4cfa-91df-f983cafbfe77",
      "name": "Telegram: 🔴 Critical",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1800,
        40
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ (() => {\n  const d = $('Loop Over Items').first().json;\n  const o = $('AI Deal Health').first().json.output;\n  const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  const money = n => String(Math.round(Number(n) || 0)).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ' ') + ' грн';\n  const link = 'https://crm.zoho.eu/crm/tab/Potentials/' + d.id;\n  const lines = [];\n  lines.push('🔴 <b>CRITICAL · Deal Health ' + o.score + '/10</b>');\n  lines.push('');\n  lines.push('<b><a href=\"' + link + '\">' + esc(d.Deal_Name) + '</a></b>');\n  lines.push('Статус: <b>' + esc(d.Stage) + '</b>');\n  lines.push('Сума: ' + money(d.Amount) + ' · Закриття: ' + (d.Closing_Date || '—').split('-').reverse().join('.'));\n  lines.push('');\n  lines.push('📋 ' + esc(o.summary));\n  if (o.risk_factors.length) {\n    lines.push('');\n    lines.push('<b>⚠️ Ризики</b>');\n    o.risk_factors.forEach(x => lines.push('• ' + esc(x)));\n  }\n  lines.push('');\n  lines.push('<b>👉 Що зробити</b>');\n  o.recommendation_actions.forEach((x, i) => lines.push((i + 1) + '. ' + esc(x)));\n  lines.push('');\n  lines.push('🔗 <a href=\"' + link + '\">Відкрити угоду в Zoho CRM</a>');\n  return lines.join('\\n');\n})() }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      }
    },
