    {
      "parameters": {
        "jsCode": "// Total count\nconst records = $('Aggregate').first().json.records ?? [];\nreturn [{ json: { count: records.length } }];"
      },
      "name": "Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        40
      ],
      "id": "hbxReportPeriod01-09"
    },
    {
      "parameters": {
        "jsCode": "// Відсоток негативних звернень\nconst records = $('Aggregate').first().json.records ?? [];\nconst neg = records.filter(r => String(r.sentiment).toLowerCase() === 'negative').length;\nreturn [{ json: { negative_sentiment_percentage: records.length ? +(neg / records.length * 100).toFixed(2) : 0 } }];"
      },
      "name": "Negative %",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        40
      ],
      "id": "hbxReportPeriod01-10"
    },
    {
      "parameters": {
        "jsCode": "// Відсоток звернень, де потрібна людина\nconst records = $('Aggregate').first().json.records ?? [];\nconst h = records.filter(r => String(r.requires_human).toLowerCase() === 'true').length;\nreturn [{ json: { requires_human_percentage: records.length ? +(h / records.length * 100).toFixed(2) : 0 } }];"
      },
      "name": "Requires human %",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        40
      ],
      "id": "hbxReportPeriod01-11"
    },
    {
      "parameters": {
        "jsCode": "// Топ-3 категорії з кількістю та відсотком\nconst records = $('Aggregate').first().json.records ?? [];\nconst counts = {};\nfor (const r of records) { const c = r.category || 'інше'; counts[c] = (counts[c] || 0) + 1; }\nconst top = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 3)\n  .map(([category, count]) => ({ category, count, percentage: +(count / records.length * 100).toFixed(2) }));\nreturn [{ json: { top_3_categories: top } }];"
      },
      "name": "Top 3 categories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        40
      ],
      "id": "hbxReportPeriod01-12"
    },
